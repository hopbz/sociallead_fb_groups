        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  post_id: $json.post_id,\n  group_name: $json.group_name,\n  group_url: $json.group_url,\n  post_url: $json.post_url,\n  author: $json.author,\n  content: $json.content,\n  score: $json.score,\n  need_stage: $json.need_stage,\n  persona: $json.persona,\n  pain_points: $json.pain_points,\n  reason: $json.reason,\n  suggested_comment: $json.suggested_comment\n} }}",
        "options": {}
      },
      "id": "save-lead",
      "name": "Save Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 220]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=🔥 Lead mới từ Facebook Group\n\n📌 Group: {{ $('Parse AI JSON').item.json.group_name }}\n👤 Tác giả: {{ $('Parse AI JSON').item.json.author }}\n⭐ Score: {{ $('Parse AI JSON').item.json.score }}/10\n🎯 Stage: {{ $('Parse AI JSON').item.json.need_stage }}\n\n🧠 Lý do:\n{{ $('Parse AI JSON').item.json.reason }}\n\n💬 Comment đề xuất:\n{{ $('Parse AI JSON').item.json.suggested_comment }}\n\n🔗 Link bài viết:\n{{ $('Parse AI JSON').item.json.post_url }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "telegram",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1060, 220]
    },
