      "parameters": {
        "method": "PATCH",
        "url": "={{($env.BACKEND_BASE_URL || 'http://host.docker.internal:3001') + '/api/v1/posts/' + $('Parse AI JSON').item.json.post_id + '/processed'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Token",
