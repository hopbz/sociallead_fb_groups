# ===== App =====
APP_NAME=SocialLead Facebook Groups Fullstack
ENV=local
API_TOKEN=replace-with-a-long-random-token
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ===== Database =====
POSTGRES_DB=sociallead_fb
POSTGRES_USER=sociallead
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg2://sociallead:replace-with-a-strong-password@db:5432/sociallead_fb

# ===== Local fallback =====
LOCAL_DATABASE_URL=sqlite:///./data/sociallead_local.db

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Browser =====
DEFAULT_ENGINE=cdp_playwright
HEADLESS=false
BROWSER_SLOW_MO_MS=80
PAGE_LOAD_TIMEOUT_MS=45000
SCROLL_WAIT_SECONDS=2.5
MAX_SCROLLS_PER_GROUP=8
MAX_POSTS_PER_GROUP=50
RETRY_TIMES=2
RETRY_SLEEP_SECONDS=3
LOGIN_WAIT_TIMEOUT_SECONDS=300
FACEBOOK_LATEST_SORTING=true
PLAYWRIGHT_PROFILE_DIR=data/profiles/playwright_fb
PLAYWRIGHT_STORAGE_STATE_FILE=data/profiles/playwright_fb/storage_state.json
SELENIUMBASE_PROFILE_DIR=data/profiles/seleniumbase_fb
UC_MODE=true
CDP_RECONNECT_TIME=3
CDP_PLAYWRIGHT_PROFILE_DIR=data/profiles/cdp_playwright_fb
SCREENSHOT_DIR=data/screenshots
LOG_FILE=data/logs/app.log
CSV_OUTPUT_FILE=data/output/facebook_group_posts.csv

# ===== Official Meta Content Library / Research access only =====
META_CONTENT_LIBRARY_ENABLED=false
META_CONTENT_LIBRARY_ACCESS_TOKEN=

# ===== Telegram optional =====
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Lead qualification runtime settings =====
LEAD_SCORE_THRESHOLD=7
LEAD_NICHE_NAME="Dịch vụ địa phương"
LEAD_POSITIVE_KEYWORDS="cần tìm, tư vấn, báo giá, recommend, looking for"
LEAD_NEGATIVE_KEYWORDS="đã mua, không cần, spam"
LEAD_COMMENT_TONE="Tự nhiên, hữu ích, lịch sự và không thúc ép inbox."
LEAD_MAX_POSTS_PER_GROUP=50
LEAD_SCAN_INTERVAL_MINUTES=30

# ===== Google Sheets optional =====
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=SocialLead_FB_Groups
GOOGLE_SERVICE_ACCOUNT_JSON=data/service_account.json

# ===== Scheduler optional =====
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=30
